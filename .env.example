#AWS Authentication and S3 Configuration
AWS_PROFILE=profile name here 
AWS_REGION=region here

S3_BUCKET_NAME=bucket name here
S3_PREFIX=prefix here

# Databricks
DATABRICKS_HOST=your_workspace_hostname_here
DATABRICKS_TOKEN=your_token_here
DATABRICKS_HTTP_PATH=your_http_path_here
DATABRICKS_DBT_PYTHON_TOKEN=your_dbt_python_token_here
BRONZE_MRF_VOLUME=/Volumes/workspace/hpt_dev/bronze_mrf_raw
SILVER_MRF_TABLE=`workspace`.`hpt_dev`.`stg_mrf_prices`

# CMS API
CMS_API_BASE_URL=https://data.cms.gov/provider-data/api/1/datastore/query

# GitHub token
GITHUB_TOKEN=your_github_token_here